# ─────────────────────────────────────────────────────────────────────────────
# Journal Bot — пример окружения. Скопируйте в .env и заполните значения.
#   cp .env.example .env
# Файл .env в git не попадает. Секреты сюда не коммитить.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN="123456789:AAH-your-bot-token-from-botfather"
SUPPORT_URL="https://t.me/your_support"
RATE_LIMIT=0.5                   # минимальный интервал между апдейтами, сек
DEBUG=False                      # True: SQL-эхо, отладочные логи (не для прода)

# Прокси для Telegram Bot API. Нужен, если VPN работает только на хосте и Docker
# не может достучаться до api.telegram.org. В Docker Desktop прокси хоста доступен
# как host.docker.internal:<порт> (например, 10809 для v2rayN/Happ HTTP-прокси).
# Пусто — прямое соединение.
TELEGRAM_PROXY=""

# ── Режим бота ──────────────────────────────────────────────────────────────
# False — polling (по умолчанию), True — webhook (нужен внешний адрес)
USE_WEBHOOK=False
WEBHOOK_HOST="0.0.0.0"           # локальный запуск: "localhost"
WEBHOOK_PORT=8080
WEBHOOK_BASE_URL="https://example.com"
WEBHOOK_PATH="/webhook"
WEBHOOK_SECRET=""                # при webhook задать случайную строку

# ── Админ-панель ────────────────────────────────────────────────────────────
ADMIN_HOST="0.0.0.0"             # локальный запуск: "localhost"
ADMIN_PORT=5000
SECRET_KEY=""                    # Flask: сгенерировать случайную строку; пусто = дефолт из config.py
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="change-me"   # сменить при первом запуске
SECURITY_PASSWORD_HASH="pbkdf2_sha512"
SECURITY_PASSWORD_SALT=""            # сгенерировать случайную строку

# ── База данных ─────────────────────────────────────────────────────────────
# В Docker хост — имя сервиса (pgbouncer); локальный запуск — "localhost"
DB_HOST="pgbouncer"
DB_PORT=5432
DB_USER="tgbot"
DB_PASS="change-me"
DB_NAME="bot_db"

# Host-порты для доступа к контейнерам с машины (локальная разработка).
# Внутри compose-сети сервисы видят друг друга по своим портам (5432/6379).
PGBOUNCER_HOST_PORT=6432
POSTGRES_HOST_PORT=6433
REDIS_HOST_PORT=6380

# ── Redis (FSM, кеш, токены — база 0) ───────────────────────────────────────
REDIS_HOST="redis"               # локальный запуск: "localhost"
REDIS_PORT=6379
REDIS_PASS=""

# ── Celery (брокер — база 1, результаты — база 2) ───────────────────────────
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"
CELERY_TIMEZONE="Europe/Moscow"
CELERY_TASK_SERIALIZER="json"
CELERY_RESULT_SERIALIZER="json"
CELERY_ACCEPT_CONTENT='["json"]'
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=250
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_CONCURRENCY=4
FLOWER_PORT=5555

# ── Шифрование учётных данных edu-tpi (обязательно) ────────────────────────
# Сгенерировать: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Смена ключа делает ранее сохранённые пароли нерасшифровываемыми — все входят заново.
ENCRYPTION_KEY=""

# ── Docker Compose ──────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=tgbot

# ── Внешние сервисы (необязательно) ────────────────────────────────────────
SENTRY_DSN=""
AMPLITUDE_API_KEY=""
POSTHOG_API_KEY=""

# ── Мониторинг ──────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="change-me"
